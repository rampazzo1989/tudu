{
  "extends": "@react-native/typescript-config/tsconfig.json",
  "compilerOptions": {
    "jsx": "react",
    "types": [
      "@types/styled-components-react-native",
      "jest"
    ],
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true
  },
  "paths": {
    "~/*": [
      "*",
    ],
    "styled-components": ["node_modules/styled-components/native"]
  },
  "exclude": [
    "node_modules",
    "tudu-api",
    "build",
    "android",
    "ios"
  ]
}
