# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'Tudu' do
  config = use_native_modules!

  # AppCheckCore (pulled in by @react-native-google-signin/google-signin) depends on
  # GoogleUtilities and RecaptchaInterop, neither of which define modules, so they
  # can't be integrated as static libraries without modular headers.
  pod 'AppCheckCore', :modular_headers => true
  pod 'GoogleUtilities', :modular_headers => true
  pod 'RecaptchaInterop', :modular_headers => true

  use_react_native!(
    :path => config[:reactNativePath],

    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
     # https://github.com/facebook/react-native/blob/main/packages/react-native/scripts/react_native_pods.rb#L197-L202
    react_native_post_install(
      installer,
      config[:reactNativePath],
      # Set `mac_catalyst_enabled` to `true` in order to apply patches
      # necessary for Mac Catalyst builds
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # Newer Clang toolchains enforce consteval format-string checks that
    # fmt 11's bundled headers trip over, breaking the build with "call to
    # consteval function ... is not a constant expression". fmt's base.h
    # (re)defines FMT_USE_CONSTEVAL itself with no `#ifndef` guard, so a
    # command-line -D override is silently discarded — the only way to win
    # is to patch the header directly to force the value off.
    fmt_header = File.join(__dir__, 'Pods/fmt/include/fmt/base.h')
    if File.exist?(fmt_header)
      contents = File.read(fmt_header)
      unless contents.include?('#undef FMT_USE_CONSTEVAL')
        patched = contents.sub(
          "#if FMT_USE_CONSTEVAL\n#  define FMT_CONSTEVAL consteval",
          "#undef FMT_USE_CONSTEVAL\n#define FMT_USE_CONSTEVAL 0\n#if FMT_USE_CONSTEVAL\n#  define FMT_CONSTEVAL consteval"
        )
        if patched != contents
          File.chmod(0644, fmt_header)
          File.write(fmt_header, patched)
        end
      end
    end
  end
end
